# Production environment template for:
# - Backend on Blaxel.ai
# - Frontend on Vercel
#
# Copy values into your hosting platforms as real environment variables.
# Keep this file out of source control if you store real secrets in it.

APP_ENV=production
ENV_FILE=.env.prod

# Backend
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/your_database?sslmode=require

# Public URLs
FRONTEND_URL=https://your-vercel-app.vercel.app
BACKEND_PUBLIC_URL=https://your-backend.blaxel.ai

# CORS
# Comma-separated list. Include your Vercel production domain and any preview/custom domains you actually use.
CORS_ORIGINS=https://your-vercel-app.vercel.app
TRUSTED_HOSTS=your-vercel-app.vercel.app,your-backend.blaxel.ai
SESSION_COOKIE_SECURE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=
FORWARDED_ALLOW_IPS=*

# Frontend
# Must point to the public backend base URL.
NEXT_PUBLIC_API_URL=https://your-backend.blaxel.ai
NEXT_PUBLIC_COOKIE_MODE=false

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
